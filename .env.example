# Database Connection
DATABASE_URL=postgresql://user:password@localhost:5432/whisper

# Admin Authentication
ADMIN_USERNAME=admin

# Use ADMIN_PASSWORD for simple local development OR ADMIN_PASSWORD_HASH for production.
# Do not use both. If both are defined, ADMIN_PASSWORD_HASH takes precedence.
ADMIN_PASSWORD=my_secure_password
# ADMIN_PASSWORD_HASH=$2b$10$abcdefghijklmnopqrstuvwxyz1234567890

# JSON Web Token Secret (Required for all environments)
JWT_SECRET=super_secret_local_key

# Optional
PORT=3000
