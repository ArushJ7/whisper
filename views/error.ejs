<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Whisper Not Found' %> | WHISPER</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Newsreader:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="header">
    <div class="nav-container">
      <a href="/" class="nav-logo">WHISPER</a>
    </div>
  </header>

  <main class="container error-page-main">
    <div class="writing-desk error-card">
      <span class="section-label">Error <%= statusCode || 404 %></span>
      <h1 class="section-title error-title"><%= title || 'This whisper is missing.' %></h1>
      <p class="section-intro error-message"><%= message || 'The page or secret you were looking for could not be located in the archive.' %></p>
      <div class="form-actions-row">
        <a href="/" class="btn btn-burgundy">Return to Home</a>
      </div>
    </div>
  </main>

  <footer class="footer">
    <div class="container footer-content">
      <div class="footer-brand">
        <div class="logo">WHISPER</div>
        <p>Say it without saying your name.</p>
      </div>
    </div>
  </footer>
</body>
</html>
